# 3. ГЛАВНОЕ МЕНЮ (Команда /start)
@bot.message_handler(commands=['start'])
def start_game_store(message):
    markup = types.ReplyKeyboardMarkup(resize_keyboard=True)
    btn_catalog = types.KeyboardButton("🎮 Каталог игр")
    btn_info = types.KeyboardButton("ℹ️ О магазине")
    btn_help = types.KeyboardButton("💬 Поддержка")

    markup.add(btn_catalog)
    markup.add(btn_info, btn_help)

    user_name = message.from_user.first_name
    welcome_text = (
        f"Привет, {user_name}! 👋\n\n"
        f"Добро пожаловать в **GameStore** — магазин лицензионных игр и ключей!\n\n"
        f"Выбери нужный раздел в меню ниже 👇"
    )
    bot.send_message(message.chat.id, welcome_text, reply_markup=markup, parse_mode="Markdown")

# 4. ОБРАБОТКА ТЕКСТОВЫХ КНОПОК МЕНЮ
@bot.message_handler(content_types=['text'])
def handle_text_menu(message):
    if message.text == "🎮 Каталог игр":
        inline_menu = types.InlineKeyboardMarkup()

        # Цикл создания кнопок категорий
        for cat_id, cat_info in GAMES_CATALOG.items():
            button = types.InlineKeyboardButton(
                text=cat_info["title"],
                callback_data=f"category:{cat_id}"
            )
            inline_menu.add(button)

        bot.send_message(message.chat.id, "📂 **Выбери жанр игры:**", reply_markup=inline_menu, parse_mode="Markdown")

    elif message.text == "ℹ️ О магазине":
        info_text = (
            "🕹 **GameStore** — твой надежный магазин игр!\n\n"
            "• Мгновенная выдача ключей активации.\n"
            "• Гарантия 100% на все товары.\n"
            "• Более 5000+ успешных продаж."
        )
        bot.send_message(message.chat.id, info_text, parse_mode="Markdown")

    elif message.text == "💬 Поддержка":
        bot.send_message(message.chat.id, f"По всем вопросам пишите менеджеру: {ADMIN_USERNAME}")

# 5. ИНЛАЙН-КЛИКИ (Категории и Покупка)
@bot.callback_query_handler(func=lambda call: True)
def handle_inline_clicks(call):
    try:
        # 5.1. Выбор категории игр
        if call.data.startswith("category:"):
            cat_id = call.data.split(":")[1]
            category_data = GAMES_CATALOG.get(cat_id)

            if category_data:
                bot.send_message(call.message.chat.id, f"📦 **Жанр: {category_data['title']}**", parse_mode="Markdown")

                # Цикл вывода карточек игр
                for game_id, game_info in category_data["games"].items():
                    buy_markup = types.InlineKeyboardMarkup()
                    buy_btn = types.InlineKeyboardButton(
                        text=f"🛒 Купить ({game_info['price']})",
                        callback_data=f"buy:{cat_id}:{game_id}"
                    )
                    buy_markup.add(buy_btn)

                    caption = f"**{game_info['name']}**\n\n{game_info['desc']}\n\n💰 **Цена:** {game_info['price']}"
                    bot.send_photo(
                        call.message.chat.id,
                        photo=game_info["photo"],
                        caption=caption,
                        parse_mode="Markdown",
                        reply_markup=buy_markup
                    )

        # 5.2. Нажатие на кнопку "Купить"
        elif call.data.startswith("buy:"):
            bot.answer_callback_query(call.id, text="Оформляем заказ!", show_alert=True)

            parts = call.data.split(":")
            cat_id = parts[1]
            game_id = parts[2]

            category_data = GAMES_CATALOG.get(cat_id)
            if category_data:
                game_info = category_data["games"].get(game_id)
                if game_info:
                    order_text = (
                        f"✅ **Заказ сформирован!**\n\n"
                        f"Игра: **{game_info['name']}**\n"
                        f"Цена: **{game_info['price']}**\n\n"
                        f"Для получения ключа и оплаты напишите менеджеру: {ADMIN_USERNAME}"
                    )
                    bot.send_message(call.message.chat.id, order_text, parse_mode="Markdown")

    except Exception as error:
        print(f"⚠️ Ошибка: {error}")
        bot.send_message(call.message.chat.id, "Произошла ошибка. Нажмите /start для сброса.")
bot.polling(none_stop=True)
